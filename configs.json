{
  "selectors": [
    {
      "class": "BBIKDJSelector",
      "alias": "少妇战法",
      "activate": true,
      "params": {
        "j_threshold": 15,
        "bbi_min_window": 20,
        "max_window": 120,
        "price_range_pct": 1,
        "bbi_q_threshold": 0.2,
        "j_q_threshold": 0.10
      }
    },
    {
      "class": "SuperB1Selector",
      "alias": "SuperB1战法",
      "activate": true,
      "params": {
        "lookback_n": 10,
        "close_vol_pct": 0.02,
        "price_drop_pct": 0.02,
        "j_threshold": 10,
        "j_q_threshold": 0.10,
        "B1_params": { 
          "j_threshold": 15,
          "bbi_min_window": 20,
          "max_window": 120,
          "price_range_pct": 1,
          "bbi_q_threshold": 0.3,
          "j_q_threshold": 0.10
        }
      }
    },
    {
      "class": "BBIShortLongSelector",
      "alias": "补票战法",
      "activate": true,
      "params": {
        "n_short": 5,
        "n_long": 21,
        "m": 5,
        "bbi_min_window": 2,
        "max_window": 120,
        "bbi_q_threshold": 0.2,
        "upper_rsv_threshold": 75,
        "lower_rsv_threshold":25
      }
    }, 
    {
      "class": "PeakKDJSelector",        
      "alias": "填坑战法",
      "activate": true,                 
      "params": {
        "j_threshold": 10,                 
        "max_window": 120,                
        "fluc_threshold": 0.03,
        "j_q_threshold": 0.10,
        "gap_threshold": 0.2
      }
    },
    {
      "class": "MA60CrossVolumeWaveSelector",
      "alias": "上穿60放量战法",
      "activate": true,
      "params": {
        "lookback_n": 25,
        "vol_multiple": 1.8,
        "j_threshold": 15,
        "j_q_threshold": 0.10,
        "ma60_slope_days": 5,
        "max_window": 120        
      }
    },
    {
      "class": "BigBullishVolumeSelector",
      "alias": "暴力K战法",
      "activate": true,
      "params": {
        "up_pct_threshold": 0.06,
        "upper_wick_pct_max": 0.02,            
        "require_bullish_close": true,
        "close_lt_zxdq_mult": 1.15,
        "vol_lookback_n": 20,
        "vol_multiple": 2.5
      }
    },
    {
      "class": "BBDMomentumSignalSelector",
      "alias": "主任BBD战法",
      "activate": true,
      "params": {
        "max_window": 240,
        "use_bbd_golden_cross": true,
        "use_momentum_golden_cross": true,
        "use_bbd_bottom_divergence": true,
        "use_momentum_bottom_divergence": true
      }
    },
    {
      "class": "BBDMomentumKDJSelector",
      "alias": "主任BBD战法-抄底",
      "activate": true,
      "params": {
        "max_window": 240,
        "kdj_j_threshold": 10,
        "use_bbd_golden_cross": true,
        "use_momentum_golden_cross": true,
        "use_bbd_bottom_divergence": true,
        "use_momentum_bottom_divergence": true
      }
    },
    {
      "class": "MultiCycleRSVSelector",
      "alias": "多周期RSV黄金坑",
      "activate": true,
      "params": {
        "max_window": 120,
        "oversold_threshold": 15,
        "use_golden_pit": true,
        "use_bottom_entry": false,
        "golden_pit_entry_only": false
      }
    },
    {
      "class": "MarketStructureBuySelector",
      "alias": "峰谷结构抄底",
      "activate": true,
      "params": {
        "max_window": 240,
        "pivot_window": 24,
        "pivot_confirm_bars": 5,
        "retest_tolerance": 0.0,
        "use_probe_signal": true,
        "use_strong_bottom_signal": true
      }
    },
    {
      "class": "MACDDivergenceBottomSelector",
      "alias": "MACD底背抄底",
      "activate": true,
      "params": {
        "max_window": 240,
        "min_diff_contraction": 0.01,
        "use_regular_divergence": true,
        "use_three_segment_divergence": true
      }
    },
    {
      "class": "BurstSignalSelector",
      "alias": "起爆启爆战法",
      "activate": true,
      "params": {
        "max_window": 240,
        "require_both_signals": false,
        "apply_xl2_filter": true,
        "xl2_filter_n": 5
      }
    },
    {
      "class": "WaveStructureSelector",
      "alias": "二波选股策略",
      "activate": true,
      "params": {
        "score_threshold": 1.0,
        "min_completed_waves": 1,
        "data_days": 70,
        "output_dir": "./wave_selection_data",
        "min_pullback": 0.04,
          "min_j_pullback_drop": 30,
        "max_pullback": 0.28,
        "min_up_return": 0.06,
        "min_step": 0.02,
        "lower_low_tolerance": 0.05,
        "active_low_break_tolerance": 0.05,
        "position_j_low_tolerance": 30,
        "position_j_decline_scale": 40,
        "position_recent_j_days": 3,
        "top_plateau_tolerance": 0.01,
        "top_plateau_after_wave": 3,
        "min_path_efficiency": 0.58,
        "up_path_efficiency_weight": 1.5,
        "up_direction_consistency_weight": 1.5,
        "pullback_path_efficiency_weight": 0.6,
        "timing_min_top_to_reference_bars": 2,
        "timing_min_reference_period": 7,
        "timing_max_reference_period": 25,
        "timing_reference_j_limit": 5,
        "timing_reference_support_tolerance": 0.0,
        "timing_low_j_threshold": 10,
        "timing_j_rebound_scale": 30,
        "timing_doji_body_ratio": 0.2,
        "timing_doji_bonus": 3.0,
        "max_open_wave_period": 25,
        "start_price_lookback": 120,
        "start_price_high_drawdown_scale": 0.40,
        "weekly_j_lookback_weeks": 26,
        "weekly_j_high_threshold": 60,
        "weekly_j_low_threshold": 10,
        "score_anchor_raw": 5.114,
        "score_reference_points": 10
      }
    },
    {
      "class": "OneWaveEntrySelector",
      "alias": "一波入场策略",
      "activate": true,
      "params": {
        "score_threshold": 1.0,
        "data_days": 70,
        "output_dir": "./one_wave_entry_data",
        "min_wave_bars": 2,
        "max_wave_bars": 20,
        "min_up_return": 0.06,
        "min_path_efficiency": 0.58,
        "path_efficiency_weight": 2.0,
        "max_up_adverse": 0.12,
        "max_one_wave_period": 30,
        "start_price_lookback": 120,
        "start_price_high_drawdown_scale": 0.40,
        "start_price_drawdown_weight": 1.5,
        "min_reference_period": 7,
        "max_reference_period": 25,
        "min_top_to_reference_bars": 2,
        "max_reference_j": 5.0,
        "max_reference_rebound": 0.15,
        "j_rebound_exit_threshold": 80.0,
        "timing_j_rebound_scale": 30.0,
        "timing_low_j_threshold": 10.0,
        "timing_doji_body_ratio": 0.2,
        "timing_doji_bonus": 3.0,
        "pullback_path_efficiency_low": 0.35,
        "pullback_path_efficiency_high": 0.85,
        "pullback_path_efficiency_penalty": 5.0,
        "max_pullback": 0.28,
        "max_observation_after_reference": 25,
        "support_close_tolerance": 0.0,
        "exclude_existing_two_wave": true,
        "existing_two_wave_score_threshold": 1.0
      }
    }
  ]
}

