# Copy to .env on cloud server and set your real token.
TUSHARE_TOKEN=your_real_tushare_token
QUANTDASH_API_KEY=your_real_quantdash_api_key
QD_SINGLE_WORKERS=1
QD_INCREMENTAL_OVERLAP_DAYS=7
QD_REQ_INTERVAL=1.20
QD_MAX_RETRIES=3
QD_SDK_MAX_RETRIES=0

# Optional Yahoo/yfinance proxy. Leave empty to use the system network.
YF_PROXY=
YAHOO_CHART_PROXY=
YAHOO_CHART_REQ_INTERVAL=0.35
YAHOO_CHART_MAX_RETRIES=3
