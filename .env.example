# Copy to .env on cloud server and set your real token.
TUSHARE_TOKEN=your_real_tushare_token
QUANTDASH_API_KEY=your_real_quantdash_api_key

# Required when STOCK_TRACKING_PUSH_ENABLED=1. Use the same value in mingzhishan/.env.
STOCK_TRACKING_API_URL=https://mingzhishan.cloud/api/v1/stock-tracking/latest
STOCK_TRACKING_PUSH_TOKEN=your_shared_stock_tracking_push_token
STOCK_TRACKING_PUSH_ENABLED=1

SELECTION_VISUALIZATION_ENABLED=1
SELECTION_DASHBOARD_ENABLED=1

QD_SINGLE_WORKERS=1
QD_INCREMENTAL_OVERLAP_DAYS=7
QD_REQ_INTERVAL=1.20
QD_MAX_RETRIES=3
QD_SDK_MAX_RETRIES=0

# Optional Yahoo/yfinance proxy. Leave empty to use the system network.
YF_PROXY=
YAHOO_CHART_PROXY=
YAHOO_CHART_REQ_INTERVAL=0.35
YAHOO_CHART_MAX_RETRIES=3

# Optional SPX index fetch from FRED (separate from stock data source)
FRED_SPX_ENABLED=1
FRED_SPX_SERIES_ID=SP500
FRED_SPX_OUTPUT=./data/indices/SPX_FRED.csv
FRED_SPX_TIMEOUT=20
FRED_SPX_STRICT=0
